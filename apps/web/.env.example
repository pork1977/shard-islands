# Where the realtime server lives.
#
# NEXT_PUBLIC_ because the browser is what connects — Next inlines it into
# the client bundle at BUILD time, so changing it in Vercel means
# redeploying the frontend, not just restarting anything.
#
# Local development leaves it unset and falls back to ws://localhost:2567.
# Production must be wss:// — a page served over https cannot open an
# insecure socket, and the browser refuses it with a mixed-content error
# that mentions nothing about WebSockets.
NEXT_PUBLIC_GAME_SERVER_URL=wss://shard-islands-server.fly.dev
